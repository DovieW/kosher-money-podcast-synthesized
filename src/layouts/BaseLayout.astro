---
import '../styles/global.css';

const {
  title = 'Kosher Money, Synthesized',
  description = 'Synthesized Orthodox Jewish money guidance from the Kosher Money podcast corpus.',
  eyebrow = 'Kosher Money, Synthesized'
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <div class="site-header__inner container">
          <a href={baseUrl} class="brand" aria-label="Kosher Money, Synthesized home">
            <span class="brand__mark">KM</span>
            <span>
              <span class="brand__eyebrow">{eyebrow}</span>
              <span class="brand__title">A readable library from the synthesized repo</span>
            </span>
          </a>

          <nav class="site-nav" aria-label="Primary">
            <a href={baseUrl}>Home</a>
            <a href={`${baseUrl}#articles`}>Articles</a>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container site-footer__inner">
          <p>
            Built from the Markdown content in this repository and deployed with GitHub Pages.
          </p>
          <p>
            Educational material only — not individualized financial, tax, legal, investment, insurance,
            mortgage, tuition, or halachic advice.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
