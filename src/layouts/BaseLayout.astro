---
import '../styles/global.css';

const {
  title = 'Kosher Money, Synthesized',
  description = 'Synthesized Orthodox Jewish money guidance from the Kosher Money podcast corpus.'
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const baseRoot = `${baseUrl.replace(/\/$/, '')}/`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={`${baseRoot}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="topbar__inner container">
          <a href={baseRoot} class="topbar__title" aria-label="Kosher Money, Synthesized home">
            Kosher Money, Synthesized
          </a>
        </div>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
