---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/content.js';

const articles = await getArticles();
---

<BaseLayout
  title="Kosher Money, Synthesized"
  description="A clean reading home for synthesized Orthodox Jewish money guidance from the Kosher Money podcast corpus."
>
  <section class="container home-intro">
    <h1>Kosher Money, Synthesized</h1>
    <p class="home-intro__subtext">
      Information distilled from 111 Kosher Money Podcast episodes
    </p>
  </section>

  <section class="container cards-section" id="articles">
    <div class="article-grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
