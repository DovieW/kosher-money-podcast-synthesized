---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/content.js';

const articles = await getArticles();
const featuredArticle = articles.find((article) => article.featured) ?? articles[0];
const remainingArticles = articles.filter((article) => article.slug !== featuredArticle.slug);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Kosher Money, Synthesized"
  description="A clean reading home for synthesized Orthodox Jewish money guidance from the Kosher Money podcast corpus."
>
  <section class="hero container">
    <div class="hero__content">
      <p class="hero__eyebrow">Orthodox money ideas, distilled</p>
      <h1>Kosher Money, synthesized into something you can actually read.</h1>
      <p class="hero__lede">
        This site turns the synthesized repo into a simple, readable library: article cards on the
        front, long-form reading pages underneath, and room to grow as new synthesized pieces get added.
      </p>

      <div class="hero__actions">
        <a href="#articles" class="button button--primary">Browse articles</a>
        <a href={`${baseUrl}articles/${featuredArticle.slug}/`} class="button button--secondary">
          Start with the featured piece
        </a>
      </div>
    </div>

    <aside class="hero-panel">
      <h2>What’s here right now</h2>
      <ul>
        <li><strong>{articles.length}</strong> synthesized Markdown pieces</li>
        <li>A growing guidebook outline published like a normal article</li>
        <li>Static delivery through GitHub Pages and Actions</li>
      </ul>
      <p>
        The stack is intentionally light: Astro for static generation, plain Markdown as the source of
        truth, and a design that can expand without becoming a yak farm.
      </p>
    </aside>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="section-heading__eyebrow">Featured read</p>
        <h2>Start with a high-signal article</h2>
      </div>
    </div>

    <ArticleCard article={featuredArticle} featured={true} />
  </section>

  <section class="section container" id="articles">
    <div class="section-heading">
      <div>
        <p class="section-heading__eyebrow">Library</p>
        <h2>All synthesized articles</h2>
      </div>
      <p>
        Each card is generated from the repo’s Markdown files, so the site stays aligned with the source
        material rather than becoming a second drifting copy.
      </p>
    </div>

    <div class="article-grid">
      {remainingArticles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
