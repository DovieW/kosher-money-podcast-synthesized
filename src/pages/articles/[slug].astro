---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticleBySlug, getArticles } from '../../lib/content.js';

export async function getStaticPaths() {
  const articles = await getArticles();

  return articles.map((article) => ({
    params: { slug: article.slug }
  }));
}

const article = await getArticleBySlug(Astro.params.slug);

if (!article) {
  throw new Error(`Article not found for slug: ${Astro.params.slug}`);
}

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`${article.title} | Kosher Money, Synthesized`} description={article.description}>
  <section class="article-hero container article-hero--page">
    <div class="article-hero__meta-row">
      <span class="pill">{article.kind}</span>
      {article.status !== 'published' && <span class="pill pill--muted">{article.status}</span>}
      <span class="article-hero__reading-time">{article.readingMinutes} min read</span>
    </div>

    <h1>{article.title}</h1>
    <p class="article-hero__description">{article.description}</p>
  </section>

  <section class="container article-shell">
    <a href={`${baseUrl}#articles`} class="back-link">← Back to the article library</a>

    <article class="article-body" set:html={article.html} />

    {(article.previous || article.next) && (
      <nav class="article-pagination" aria-label="Article pagination">
        {article.previous ? (
          <a href={`${baseUrl}articles/${article.previous.slug}/`} class="article-pagination__card">
            <span class="article-pagination__label">Previous</span>
            <strong>{article.previous.title}</strong>
          </a>
        ) : <div />}

        {article.next ? (
          <a href={`${baseUrl}articles/${article.next.slug}/`} class="article-pagination__card article-pagination__card--next">
            <span class="article-pagination__label">Next</span>
            <strong>{article.next.title}</strong>
          </a>
        ) : <div />}
      </nav>
    )}
  </section>
</BaseLayout>
