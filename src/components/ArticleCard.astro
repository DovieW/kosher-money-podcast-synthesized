---
const { article } = Astro.props;
const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/articles/${article.slug}/`;
---

<article class="article-card">
  <div class="article-card__meta">
    <span class="pill">{article.kind}</span>
    {article.status !== 'published' && <span class="pill pill--muted">{article.status}</span>}
    <span class="article-card__reading-time">{article.readingMinutes} min read</span>
  </div>

  <h2 class="article-card__title">
    <a href={href}>{article.title}</a>
  </h2>

  <p class="article-card__description">{article.description}</p>
</article>
